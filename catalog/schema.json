{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dsh-nano-market catalog entry (one JSONL line)",
  "type": "object",
  "required": ["kind", "name"],
  "properties": {
    "kind": { "enum": ["git", "npm", "local"] },
    "name": { "type": "string", "description": "npm package name (must equal the installed manifest's name for git sources)" },
    "repo": { "type": "string", "pattern": "^https://github.com/[^/]+/[^/]+$", "description": "canonical https GitHub repo URL (git source)" },
    "path": { "type": "string", "description": "package directory inside the repo (ascii segments); absent = repo root" },
    "ref": { "type": "string", "description": "tag preferred, else branch; resolved to a pinned commit at build time" },
    "registry": { "type": "string", "description": "optional npm registry URL (npm source)" },
    "distTags": { "type": "object", "description": "market-supplied tag-to-exact-version map, e.g. {"latest": "0.1.0"}" },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "object", "description": "LocalizedText, en required" },
        "description": { "type": "object", "description": "LocalizedText" },
        "icon": { "type": "string", "description": "relative (icons/x.svg), absolute https URL, or inline data: (<=32KiB)" },
        "author": { "type": "string" },
        "homepage": { "type": "string" },
        "repository": { "type": "object", "description": "{url, directory?} display only, never selects the install source" },
        "category": { "type": "string", "description": "declared category id (AGENTS.md §4 taxonomy)" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "sortKeys": { "type": "object" }
      }
    }
  }
}
