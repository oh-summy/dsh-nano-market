{
  "name": "@oh-summy/nano-market",
  "version": "0.1.0-beta.1",
  "icon": "./icon.svg",
  "private": true,
  "description": "Nano Market — the DSH plugin market page: browse, install, enable, disable, and uninstall every plugin registered in this market.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.4 || >=0.2.2-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "nano-market",
    "market",
    "plugin"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown src/index.ts -d lib --format esm && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
