{
  "name": "@oh-summy/dsh-remote",
  "version": "0.3.0-beta.1",
  "icon": "./icon.svg",
  "private": true,
  "description": "Remote access for DSH via a Cloudflare quick tunnel with a password gate. The management page now lives in the plugin's own detail page (Plugins → Nano Market → configure).",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.4 || >=0.2.2-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "remote",
    "tunnel",
    "cloudflare"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown src/index.ts -d lib --format esm && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ]
}
