{
  "name": "@oh-summy/connect-lark",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "private": true,
  "description": "Feishu/Lark long-connection bridge for DSH: forwards messages to local DSH agents with streaming rich cards, image support, and workspace-aware replies.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.4 || >=0.2.2-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "connect-lark",
    "lark",
    "feishu",
    "chatbot",
    "channel",
    "cordis"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown src/index.ts -d lib --format esm && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@larksuite/channel": "0.7.1",
    "@larksuiteoapi/node-sdk": "1.73.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "meta": {
    "title": {
      "en": "connect-lark",
      "zh": "connect-lark 飞书桥接"
    },
    "description": {
      "en": "Feishu/Lark long-connection bridge for DSH: forwards messages to local DSH agents with streaming rich cards, image support, and workspace-aware replies.",
      "zh": "飞书/Lark 长连接桥接 DSH：把飞书消息接到本地 DSH agent，流式富卡片回复，支持图片和工作区。"
    }
  }
}
