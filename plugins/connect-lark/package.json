{
  "name": "@oh-summy/connect-lark",
  "version": "0.1.0",
  "private": true,
  "description": "Feishu/Lark long-connection channel for DSH: chats drive the local agent, replies stream as rich cards. Not yet registered in the market.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 || >=0.2.2-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "connect-lark",
    "lark",
    "feishu",
    "chatbot",
    "channel",
    "cordis"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown src/index.ts -d lib --format esm",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@larksuite/channel": "0.7.1",
    "@larksuiteoapi/node-sdk": "1.73.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
